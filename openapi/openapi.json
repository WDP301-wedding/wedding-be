{
  "components": {
    "headers": {
      "RequestId": {
        "description": "Request correlation identifier.",
        "schema": {
          "$ref": "#/components/schemas/RequestId"
        }
      },
      "RetryAfter": {
        "description": "Positive integer number of seconds before the caller should retry.",
        "schema": {
          "example": "1",
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "description": "Required on operations documented as idempotent.",
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/IdempotencyKey"
        }
      },
      "RequestId": {
        "description": "Trusted callers may supply a UUID request ID; otherwise the service generates one.",
        "in": "header",
        "name": "x-request-id",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/RequestId"
        }
      }
    },
    "responses": {
      "BadGateway": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "PROVIDER_ERROR",
                "message": "An upstream service returned an error.",
                "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "An upstream service returned an error.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "BadRequest": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "MALFORMED_JSON",
                "message": "The request body contains malformed JSON.",
                "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The request is malformed or misses a required header.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "Conflict": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "CONFLICT",
                "message": "The request conflicts with the current state.",
                "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The request conflicts with the current state.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "Forbidden": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "FORBIDDEN",
                "message": "The request is forbidden.",
                "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The authenticated actor is not permitted to perform this action.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "GatewayTimeout": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "PROVIDER_TIMEOUT",
                "message": "An upstream service timed out.",
                "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "An upstream service timed out.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "IdempotencyKeyRequired": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "IDEMPOTENCY_KEY_REQUIRED",
                "message": "An Idempotency-Key header is required.",
                "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The operation requires an Idempotency-Key header.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "IdempotencyKeyReused": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "IDEMPOTENCY_KEY_REUSED",
                "message": "The Idempotency-Key was already used for a different request.",
                "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The Idempotency-Key was previously claimed with a different request payload.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "InternalServerError": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "INTERNAL_ERROR",
                "message": "An unexpected error occurred.",
                "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "An unexpected internal error occurred.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "InvalidIdempotencyKey": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "INVALID_IDEMPOTENCY_KEY",
                "message": "The Idempotency-Key header is invalid.",
                "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The supplied Idempotency-Key is invalid.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "NotFound": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "NOT_FOUND",
                "message": "The requested resource was not found.",
                "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The resource is absent or intentionally concealed.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "RequestInProgress": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "REQUEST_IN_PROGRESS",
                "message": "A request with this Idempotency-Key is still in progress.",
                "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "An identical request is still being processed and must not be re-executed.",
        "headers": {
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          },
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "ServiceUnavailable": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "SERVICE_UNAVAILABLE",
                "message": "The service is not ready.",
                "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The service or an upstream dependency is unavailable.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "TooManyRequests": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "RATE_LIMITED",
                "message": "Too many requests.",
                "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The caller exceeded an enforced request limit.",
        "headers": {
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          },
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "UNAUTHORIZED",
                "message": "Authentication is required.",
                "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "Authentication is missing or invalid.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "UnprocessableEntity": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "VALIDATION_ERROR",
                "details": [
                  {
                    "code": "invalid_format",
                    "message": "Email must be valid.",
                    "path": "email"
                  }
                ],
                "message": "The request is invalid.",
                "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The request fails schema or business validation.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      }
    },
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "example": "invalid_format",
            "type": "string"
          },
          "message": {
            "example": "Email must be valid.",
            "type": "string"
          },
          "path": {
            "example": "email",
            "type": "string"
          }
        },
        "required": [
          "path",
          "code",
          "message"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "example": "VALIDATION_ERROR",
                "pattern": "^[A-Z][A-Z0-9_]*$",
                "type": "string"
              },
              "details": {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              "message": {
                "example": "The request is invalid.",
                "minLength": 1,
                "type": "string"
              },
              "requestId": {
                "$ref": "#/components/schemas/RequestId"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "HealthLiveResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "$ref": "#/components/schemas/RequestId"
              },
              "status": {
                "const": "live",
                "type": "string"
              }
            },
            "required": [
              "status",
              "requestId"
            ],
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "HealthReadyResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "$ref": "#/components/schemas/RequestId"
              },
              "status": {
                "const": "ready",
                "type": "string"
              }
            },
            "required": [
              "status",
              "requestId"
            ],
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "HealthUnavailableResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "const": "SERVICE_UNAVAILABLE",
                "type": "string"
              },
              "message": {
                "const": "The service is not ready.",
                "type": "string"
              },
              "requestId": {
                "$ref": "#/components/schemas/RequestId"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "IdempotencyKey": {
        "description": "A 1–128 character printable ASCII key that identifies one client intent and is reused for retries of that intent.",
        "example": "booking:24dcfaac-4408-4d42-8d66-456ed6ee7ea4",
        "pattern": "^[\\x20-\\x7e]{1,128}$",
        "type": "string"
      },
      "PaginationMetadata": {
        "additionalProperties": false,
        "description": "Pagination metadata returned by list endpoints.",
        "properties": {
          "page": {
            "example": 1,
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "example": 20,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "totalItems": {
            "example": 0,
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "totalPages": {
            "example": 0,
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "page",
          "pageSize",
          "totalItems",
          "totalPages"
        ],
        "type": "object"
      },
      "RequestId": {
        "description": "UUID used to correlate one HTTP request across responses and telemetry.",
        "example": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string"
      }
    }
  },
  "info": {
    "description": "Canonical HTTP contract for the wedding management backend.",
    "title": "Wedding Management API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getHealthLive",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4",
                    "status": "live"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/HealthLiveResponse"
                }
              }
            },
            "description": "The process is alive.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "summary": "Check process liveness",
        "tags": [
          "Health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getHealthReady",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4",
                    "status": "ready"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/HealthReadyResponse"
                }
              }
            },
            "description": "The service and its required dependencies are ready.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "SERVICE_UNAVAILABLE",
                    "message": "The service is not ready.",
                    "requestId": "24dcfaac-4408-4d42-8d66-456ed6ee7ea4"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/HealthUnavailableResponse"
                }
              }
            },
            "description": "The service is not ready.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          }
        },
        "summary": "Check service readiness",
        "tags": [
          "Health"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Process liveness and dependency readiness.",
      "name": "Health"
    }
  ]
}
