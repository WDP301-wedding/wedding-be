# Runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
RESTAURANT_TIME_ZONE=Asia/Ho_Chi_Minh

# Comma-separated browser origins. Put Public Web first; credential links use that origin.
# Use the two HTTPS web origins in staging/production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# HTTP security baseline. The rate limiter is in-process, so deployments must stay at one replica.
HTTP_BODY_LIMIT_BYTES=1048576
HTTP_REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
BACKEND_REPLICA_COUNT=1

# Identity and access security policy (approved values are fail-closed).
# 0 = direct client connection; 1 = exactly one trusted reverse proxy.
AUTH_TRUST_PROXY_HOPS=0
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_IDLE_TTL_SECONDS=2592000
AUTH_REFRESH_ABSOLUTE_TTL_SECONDS=7776000
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
# Independent secret for hashing email OTPs. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required outside development/test; keep stable across restarts and out of source control.
AUTH_OTP_HASH_KEY=
AUTH_INVITATION_TTL_SECONDS=259200
AUTH_INVITATION_REISSUE_LIMIT=3
AUTH_INVITATION_REISSUE_WINDOW_SECONDS=86400
AUTH_PASSWORD_MIN_CHARACTERS=12
AUTH_PASSWORD_MAX_CHARACTERS=128
AUTH_PASSWORD_MAX_BYTES=512
AUTH_SCRYPT_COST=131072
AUTH_SCRYPT_BLOCK_SIZE=8
AUTH_SCRYPT_PARALLELIZATION=1
AUTH_SCRYPT_KEY_LENGTH_BYTES=64
AUTH_SCRYPT_MAX_MEMORY_BYTES=268435456
AUTH_TOKEN_ENTROPY_BYTES=32
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_TOKEN_CONSUME_RATE_LIMIT_MAX=10
AUTH_TOKEN_CONSUME_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RESET_REQUEST_RATE_LIMIT_MAX=3
AUTH_RESET_REQUEST_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_REFRESH_RATE_LIMIT_MAX=60
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_INVITATION_RETENTION_DAYS=180
AUTH_PASSWORD_RESET_RETENTION_DAYS=30
AUTH_SESSION_RETENTION_DAYS=90
AUTH_DISABLED_ACCOUNT_PII_RETENTION_DAYS=365

# PostgreSQL. Staging/production URLs must set sslmode=require (or a stricter mode).
DATABASE_URL=postgresql://app:replace-me@localhost:5432/wedding
MIGRATION_DATABASE_URL=postgresql://migrate:replace-me@localhost:5432/wedding
# Integration tests may create and drop schemas. Point this only at disposable PostgreSQL.
TEST_MIGRATION_DATABASE_URL=

# Supabase Storage. Configure all three values together.
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=wedding-media

# Brevo transactional email. Configure both values together; blanks disable email locally.
# Use an API key (not an SMTP key) and a sender verified in your Brevo account.
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# Optional legacy Resend configuration. Leave both blank when using Brevo.
# Only one email provider may be configured at a time.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# AI image generation is disabled when AI_IMAGE_PROVIDER is blank.
AI_IMAGE_PROVIDER=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=

# Metrics are disabled by default. METRICS_TOKEN is required when enabled.
METRICS_ENABLED=false
METRICS_TOKEN=

# OpenAPI and /docs (Swagger UI with live Try it out) are served outside production.
# Opt in explicitly for production; mutations execute against the live database.
OPENAPI_ENABLED=false

# Optional OpenTelemetry HTTP(S) collector endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
