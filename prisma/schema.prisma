generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum AuditActorType {
  SYSTEM
  USER
  GUEST_LINK
}

enum IdempotencyStatus {
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AccountRoleType {
  MANAGER
  STAFF
  COUPLE
}

enum ConsultationAccessLevel {
  RESTRICTED
  FULL
}

enum WorkspaceInvitationStatus {
  ACTIVE
  ACCEPTED
  REVOKED
  SUPERSEDED
  EXPIRED
}

enum SessionClientKind {
  WEB
  ANDROID
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  COMPROMISED
}

enum CredentialStatus {
  ACTIVE
  CONSUMED
  REVOKED
  EXPIRED
}

enum CatalogLifecycle {
  ACTIVE
  RETIRED
}

enum CatalogVersionState {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum RestaurantShiftCode {
  LUNCH
  DINNER
}

enum LayoutTableShape {
  ROUND
  RECTANGLE
}

enum CatalogMediaResourceType {
  RESTAURANT_PROFILE
  HALL
  DISH_VERSION
  MENU_PACKAGE_VERSION
  TIMELINE_TEMPLATE_VERSION
  LAYOUT_TEMPLATE_VERSION
}

model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  occurredAt DateTime       @default(now()) @db.Timestamptz(6)
  requestId  String         @db.Uuid
  actorType  AuditActorType
  actorId    String?        @db.Uuid
  action     String
  entityType String
  entityId   String?        @db.Uuid
  metadata   Json           @db.JsonB

  @@index([occurredAt(sort: Desc)])
  @@index([requestId])
  @@index([actorType, actorId])
  @@index([entityType, entityId])
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  namespace      String
  idempotencyKey String
  requestHash    String
  status         IdempotencyStatus
  responseStatus Int?              @db.SmallInt
  responseBody   Json?             @db.JsonB
  resourceType   String?
  resourceId     String?           @db.Uuid
  lockedAt       DateTime          @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime          @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  @@unique([namespace, idempotencyKey])
  @@index([status, lockedAt])
  @@index([expiresAt])
  @@index([resourceType, resourceId])
}

model Account {
  id                     String                            @id @default(uuid()) @db.Uuid
  emailNormalized        String                            @unique
  displayEmail           String
  status                 AccountStatus                     @default(ACTIVE)
  disabledAt             DateTime?                         @db.Timestamptz(6)
  piiRetentionEligibleAt DateTime?                         @db.Timestamptz(6)
  piiAnonymizedAt        DateTime?                         @db.Timestamptz(6)
  legalHoldUntil         DateTime?                         @db.Timestamptz(6)
  createdAt              DateTime                          @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                          @updatedAt @db.Timestamptz(6)
  passwordCredential     PasswordCredential?
  roles                  AccountRole[]
  consultationAccesses   ConsultationAccess[]
  invitations            WorkspaceInvitation[]             @relation("InvitationAccount")
  issuedInvitations      WorkspaceInvitation[]             @relation("InvitationIssuer")
  sessions               Session[]
  passwordResets         PasswordResetCredential[]
  retentionFacts         AccountRetentionEligibilityFact[]

  @@index([status])
  @@index([piiRetentionEligibleAt])
}

model PasswordCredential {
  accountId         String   @id @db.Uuid
  algorithm         String
  version           Int      @db.SmallInt
  cost              Int
  blockSize         Int
  parallelization   Int
  keyLengthBytes    Int      @db.SmallInt
  maxMemoryBytes    Int
  saltEncoded       String
  derivedKeyEncoded String
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model AccountRole {
  id        String          @id @default(uuid()) @db.Uuid
  accountId String          @db.Uuid
  role      AccountRoleType
  grantedAt DateTime        @default(now()) @db.Timestamptz(6)
  account   Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, role])
  @@index([role])
}

model ConsultationAccess {
  id              String                  @id @default(uuid()) @db.Uuid
  accountId       String                  @db.Uuid
  consultationId  String                  @db.Uuid
  bookingId       String?                 @unique @db.Uuid
  level           ConsultationAccessLevel @default(RESTRICTED)
  promotedAt      DateTime?               @db.Timestamptz(6)
  sourcePaymentId String?                 @unique @db.Uuid
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(6)
  account         Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, consultationId])
  @@index([consultationId, level])
}

model WorkspaceInvitation {
  id                       String                    @id @default(uuid()) @db.Uuid
  consultationId           String                    @db.Uuid
  recipientEmailNormalized String
  resolvedAccountId        String?                   @db.Uuid
  issuedByAccountId        String                    @db.Uuid
  sequence                 Int
  tokenHash                String                    @unique
  status                   WorkspaceInvitationStatus @default(ACTIVE)
  expiresAt                DateTime                  @db.Timestamptz(6)
  acceptedAt               DateTime?                 @db.Timestamptz(6)
  revokedAt                DateTime?                 @db.Timestamptz(6)
  supersededAt             DateTime?                 @db.Timestamptz(6)
  expiredAt                DateTime?                 @db.Timestamptz(6)
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(6)
  resolvedAccount          Account?                  @relation("InvitationAccount", fields: [resolvedAccountId], references: [id], onDelete: SetNull)
  issuedByAccount          Account                   @relation("InvitationIssuer", fields: [issuedByAccountId], references: [id], onDelete: Restrict)

  @@unique([consultationId, recipientEmailNormalized, sequence])
  @@unique([consultationId, recipientEmailNormalized], map: "WorkspaceInvitation_active_consultation_email_key", where: raw("\"status\" = 'ACTIVE'"))
  @@index([recipientEmailNormalized, createdAt(sort: Desc)])
  @@index([status, expiresAt])
}

model Session {
  id                 String              @id @default(uuid()) @db.Uuid
  accountId          String              @db.Uuid
  clientKind         SessionClientKind
  status             SessionStatus       @default(ACTIVE)
  refreshFamilyId    String              @unique @db.Uuid
  idleExpiresAt      DateTime            @db.Timestamptz(6)
  absoluteExpiresAt  DateTime            @db.Timestamptz(6)
  lastSeenAt         DateTime            @default(now()) @db.Timestamptz(6)
  revokedAt          DateTime?           @db.Timestamptz(6)
  revocationReason   String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  account            Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessCredentials  AccessCredential[]
  refreshCredentials RefreshCredential[]

  @@index([accountId, status])
  @@index([status, idleExpiresAt])
  @@index([status, absoluteExpiresAt])
}

model AccessCredential {
  id        String           @id @default(uuid()) @db.Uuid
  sessionId String           @db.Uuid
  tokenHash String           @unique
  status    CredentialStatus @default(ACTIVE)
  expiresAt DateTime         @db.Timestamptz(6)
  revokedAt DateTime?        @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  session   Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([status, expiresAt])
}

model RefreshCredential {
  id            String             @id @default(uuid()) @db.Uuid
  sessionId     String             @db.Uuid
  predecessorId String?            @unique @db.Uuid
  tokenHash     String             @unique
  status        CredentialStatus   @default(ACTIVE)
  expiresAt     DateTime           @db.Timestamptz(6)
  consumedAt    DateTime?          @db.Timestamptz(6)
  revokedAt     DateTime?          @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  session       Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  predecessor   RefreshCredential? @relation("RefreshRotation", fields: [predecessorId], references: [id], onDelete: Restrict)
  successor     RefreshCredential? @relation("RefreshRotation")

  @@index([sessionId, status])
  @@index([status, expiresAt])
}

model PasswordResetCredential {
  id         String           @id @default(uuid()) @db.Uuid
  accountId  String           @db.Uuid
  tokenHash  String           @unique
  status     CredentialStatus @default(ACTIVE)
  expiresAt  DateTime         @db.Timestamptz(6)
  consumedAt DateTime?        @db.Timestamptz(6)
  revokedAt  DateTime?        @db.Timestamptz(6)
  expiredAt  DateTime?        @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  account    Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
  @@index([status, expiresAt])
}

model AccountRetentionEligibilityFact {
  id                     String   @id @default(uuid()) @db.Uuid
  accountId              String   @db.Uuid
  consultationId         String   @db.Uuid
  sourceBusinessRecordId String   @unique @db.Uuid
  eligibleAfter          DateTime @db.Timestamptz(6)
  recordedAt             DateTime @default(now()) @db.Timestamptz(6)
  account                Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, consultationId])
  @@index([accountId, eligibleAfter])
}

model RestaurantProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  singletonKey       String   @unique @default("RESTAURANT")
  displayName        String
  description        String
  address            String
  publicPhone        String?
  publicEmail        String?
  revision           Int      @default(1)
  updatedByAccountId String   @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)
}

model RestaurantShift {
  code               RestaurantShiftCode @id
  startTime          DateTime            @db.Time(0)
  endTime            DateTime            @db.Time(0)
  isActive           Boolean             @default(true)
  revision           Int                 @default(1)
  updatedByAccountId String              @db.Uuid
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
}

model Hall {
  id                 String           @id @default(uuid()) @db.Uuid
  name               String
  nameNormalized     String
  description        String
  maxGuests          Int
  displayOrder       Int
  lifecycle          CatalogLifecycle @default(ACTIVE)
  revision           Int              @default(1)
  retiredAt          DateTime?        @db.Timestamptz(6)
  updatedByAccountId String           @db.Uuid
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)
  layoutTemplates    LayoutTemplate[]

  @@unique([nameNormalized], map: "Hall_active_name_key", where: raw("\"lifecycle\" = 'ACTIVE'"))
  @@index([lifecycle, displayOrder, id])
}

model Dish {
  id                        String           @id @default(uuid()) @db.Uuid
  lifecycle                 CatalogLifecycle @default(ACTIVE)
  displayOrder              Int
  revision                  Int              @default(1)
  currentPublishedVersionId String?          @db.Uuid
  draftVersionId            String?          @db.Uuid
  retiredAt                 DateTime?        @db.Timestamptz(6)
  createdByAccountId        String           @db.Uuid
  updatedByAccountId        String           @db.Uuid
  createdAt                 DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime         @updatedAt @db.Timestamptz(6)
  versions                  DishVersion[]    @relation("DishVersions")
  currentPublishedVersion   DishVersion?     @relation("DishCurrentVersion", fields: [currentPublishedVersionId, id], references: [id, dishId], onDelete: Restrict, onUpdate: NoAction)
  draftVersion              DishVersion?     @relation("DishDraftVersion", fields: [draftVersionId, id], references: [id, dishId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([currentPublishedVersionId, id])
  @@unique([draftVersionId, id])
  @@index([lifecycle, displayOrder, id])
}

model DishVersion {
  id                 String              @id @default(uuid()) @db.Uuid
  dishId             String              @db.Uuid
  versionNumber      Int?
  revision           Int                 @default(1)
  state              CatalogVersionState @default(DRAFT)
  name               String
  description        String
  categoryLabel      String
  priceVnd           Decimal?            @db.Decimal(18, 0)
  createdByAccountId String              @db.Uuid
  publishedAt        DateTime?           @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  dish               Dish                @relation("DishVersions", fields: [dishId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentFor         Dish?               @relation("DishCurrentVersion")
  draftFor           Dish?               @relation("DishDraftVersion")
  menuItems          MenuPackageItem[]

  @@unique([id, dishId])
  @@unique([dishId, versionNumber])
  @@unique([dishId], map: "DishVersion_one_draft_key", where: raw("\"state\" = 'DRAFT'"))
  @@unique([dishId], map: "DishVersion_one_current_key", where: raw("\"state\" = 'PUBLISHED'"))
  @@index([dishId, state])
}

model MenuPackage {
  id                        String               @id @default(uuid()) @db.Uuid
  lifecycle                 CatalogLifecycle     @default(ACTIVE)
  displayOrder              Int
  revision                  Int                  @default(1)
  currentPublishedVersionId String?              @db.Uuid
  draftVersionId            String?              @db.Uuid
  retiredAt                 DateTime?            @db.Timestamptz(6)
  createdByAccountId        String               @db.Uuid
  updatedByAccountId        String               @db.Uuid
  createdAt                 DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime             @updatedAt @db.Timestamptz(6)
  versions                  MenuPackageVersion[] @relation("MenuPackageVersions")
  currentPublishedVersion   MenuPackageVersion?  @relation("MenuPackageCurrentVersion", fields: [currentPublishedVersionId, id], references: [id, menuPackageId], onDelete: Restrict, onUpdate: NoAction)
  draftVersion              MenuPackageVersion?  @relation("MenuPackageDraftVersion", fields: [draftVersionId, id], references: [id, menuPackageId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([currentPublishedVersionId, id])
  @@unique([draftVersionId, id])
  @@index([lifecycle, displayOrder, id])
}

model MenuPackageVersion {
  id                 String              @id @default(uuid()) @db.Uuid
  menuPackageId      String              @db.Uuid
  versionNumber      Int?
  revision           Int                 @default(1)
  state              CatalogVersionState @default(DRAFT)
  name               String
  description        String
  priceVndPerTable   Decimal             @db.Decimal(18, 0)
  createdByAccountId String              @db.Uuid
  publishedAt        DateTime?           @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  menuPackage        MenuPackage         @relation("MenuPackageVersions", fields: [menuPackageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentFor         MenuPackage?        @relation("MenuPackageCurrentVersion")
  draftFor           MenuPackage?        @relation("MenuPackageDraftVersion")
  items              MenuPackageItem[]

  @@unique([id, menuPackageId])
  @@unique([menuPackageId, versionNumber])
  @@unique([menuPackageId], map: "MenuPackageVersion_one_draft_key", where: raw("\"state\" = 'DRAFT'"))
  @@unique([menuPackageId], map: "MenuPackageVersion_one_current_key", where: raw("\"state\" = 'PUBLISHED'"))
  @@index([menuPackageId, state])
}

model MenuPackageItem {
  id                   String             @id @default(uuid()) @db.Uuid
  menuPackageVersionId String             @db.Uuid
  dishVersionId        String             @db.Uuid
  displayOrder         Int
  menuPackageVersion   MenuPackageVersion @relation(fields: [menuPackageVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dishVersion          DishVersion        @relation(fields: [dishVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([menuPackageVersionId, dishVersionId])
  @@unique([menuPackageVersionId, displayOrder])
}

model TimelineTemplate {
  id                        String                    @id @default(uuid()) @db.Uuid
  lifecycle                 CatalogLifecycle          @default(ACTIVE)
  displayOrder              Int
  revision                  Int                       @default(1)
  currentPublishedVersionId String?                   @db.Uuid
  draftVersionId            String?                   @db.Uuid
  retiredAt                 DateTime?                 @db.Timestamptz(6)
  createdByAccountId        String                    @db.Uuid
  updatedByAccountId        String                    @db.Uuid
  createdAt                 DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                  @updatedAt @db.Timestamptz(6)
  versions                  TimelineTemplateVersion[] @relation("TimelineTemplateVersions")
  currentPublishedVersion   TimelineTemplateVersion?  @relation("TimelineTemplateCurrentVersion", fields: [currentPublishedVersionId, id], references: [id, timelineTemplateId], onDelete: Restrict, onUpdate: NoAction)
  draftVersion              TimelineTemplateVersion?  @relation("TimelineTemplateDraftVersion", fields: [draftVersionId, id], references: [id, timelineTemplateId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([currentPublishedVersionId, id])
  @@unique([draftVersionId, id])
  @@index([lifecycle, displayOrder, id])
}

model TimelineTemplateVersion {
  id                 String                 @id @default(uuid()) @db.Uuid
  timelineTemplateId String                 @db.Uuid
  versionNumber      Int?
  revision           Int                    @default(1)
  state              CatalogVersionState    @default(DRAFT)
  name               String
  description        String
  createdByAccountId String                 @db.Uuid
  publishedAt        DateTime?              @db.Timestamptz(6)
  createdAt          DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(6)
  timelineTemplate   TimelineTemplate       @relation("TimelineTemplateVersions", fields: [timelineTemplateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentFor         TimelineTemplate?      @relation("TimelineTemplateCurrentVersion")
  draftFor           TimelineTemplate?      @relation("TimelineTemplateDraftVersion")
  items              TimelineTemplateItem[]

  @@unique([id, timelineTemplateId])
  @@unique([timelineTemplateId, versionNumber])
  @@unique([timelineTemplateId], map: "TimelineTemplateVersion_one_draft_key", where: raw("\"state\" = 'DRAFT'"))
  @@unique([timelineTemplateId], map: "TimelineTemplateVersion_one_current_key", where: raw("\"state\" = 'PUBLISHED'"))
  @@index([timelineTemplateId, state])
}

model TimelineTemplateItem {
  id                        String                  @id @db.Uuid
  timelineTemplateVersionId String                  @db.Uuid
  title                     String
  description               String?
  offsetMinutes             Int
  durationMinutes           Int?
  displayOrder              Int
  timelineTemplateVersion   TimelineTemplateVersion @relation(fields: [timelineTemplateVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([timelineTemplateVersionId, id])
  @@unique([timelineTemplateVersionId, displayOrder])
}

model LayoutTemplate {
  id                        String                  @id @default(uuid()) @db.Uuid
  hallId                    String                  @db.Uuid
  lifecycle                 CatalogLifecycle        @default(ACTIVE)
  displayOrder              Int
  revision                  Int                     @default(1)
  currentPublishedVersionId String?                 @db.Uuid
  draftVersionId            String?                 @db.Uuid
  retiredAt                 DateTime?               @db.Timestamptz(6)
  createdByAccountId        String                  @db.Uuid
  updatedByAccountId        String                  @db.Uuid
  createdAt                 DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                @updatedAt @db.Timestamptz(6)
  hall                      Hall                    @relation(fields: [hallId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions                  LayoutTemplateVersion[] @relation("LayoutTemplateVersions")
  tableIdentities           LayoutTableIdentity[]
  currentPublishedVersion   LayoutTemplateVersion?  @relation("LayoutTemplateCurrentVersion", fields: [currentPublishedVersionId, id], references: [id, layoutTemplateId], onDelete: Restrict, onUpdate: NoAction)
  draftVersion              LayoutTemplateVersion?  @relation("LayoutTemplateDraftVersion", fields: [draftVersionId, id], references: [id, layoutTemplateId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([currentPublishedVersionId, id])
  @@unique([draftVersionId, id])
  @@index([hallId, lifecycle, displayOrder, id])
}

model LayoutTemplateVersion {
  id                 String                @id @default(uuid()) @db.Uuid
  layoutTemplateId   String                @db.Uuid
  versionNumber      Int?
  revision           Int                   @default(1)
  state              CatalogVersionState   @default(DRAFT)
  name               String
  description        String
  minGuests          Int
  maxGuests          Int
  createdByAccountId String                @db.Uuid
  publishedAt        DateTime?             @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(6)
  layoutTemplate     LayoutTemplate        @relation("LayoutTemplateVersions", fields: [layoutTemplateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentFor         LayoutTemplate?       @relation("LayoutTemplateCurrentVersion")
  draftFor           LayoutTemplate?       @relation("LayoutTemplateDraftVersion")
  geometry           LayoutTableGeometry[]

  @@unique([id, layoutTemplateId])
  @@unique([layoutTemplateId, versionNumber])
  @@unique([layoutTemplateId], map: "LayoutTemplateVersion_one_draft_key", where: raw("\"state\" = 'DRAFT'"))
  @@unique([layoutTemplateId], map: "LayoutTemplateVersion_one_current_key", where: raw("\"state\" = 'PUBLISHED'"))
  @@index([layoutTemplateId, state])
}

model LayoutTableIdentity {
  id                 String                @id @db.Uuid
  layoutTemplateId   String                @db.Uuid
  createdByAccountId String                @db.Uuid
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  retiredAt          DateTime?             @db.Timestamptz(6)
  layoutTemplate     LayoutTemplate        @relation(fields: [layoutTemplateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  geometry           LayoutTableGeometry[]

  @@unique([id, layoutTemplateId])
  @@index([layoutTemplateId, retiredAt])
}

model LayoutTableGeometry {
  id                      String                @id @default(uuid()) @db.Uuid
  layoutTemplateVersionId String                @db.Uuid
  layoutTemplateId        String                @db.Uuid
  tableId                 String                @db.Uuid
  label                   String
  shape                   LayoutTableShape
  seatCapacity            Int
  x                       Int
  y                       Int
  width                   Int
  height                  Int
  rotationDegrees         Int
  displayOrder            Int
  layoutTemplateVersion   LayoutTemplateVersion @relation(fields: [layoutTemplateVersionId, layoutTemplateId], references: [id, layoutTemplateId], onDelete: Restrict, onUpdate: Cascade)
  tableIdentity           LayoutTableIdentity   @relation(fields: [tableId, layoutTemplateId], references: [id, layoutTemplateId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([layoutTemplateVersionId, tableId])
  @@unique([layoutTemplateVersionId, displayOrder])
  @@index([layoutTemplateId, tableId])
}

model CatalogMediaAsset {
  id                 String                   @id @default(uuid()) @db.Uuid
  resourceType       CatalogMediaResourceType
  resourceId         String                   @db.Uuid
  objectKey          String                   @unique
  checksumSha256     String
  contentType        String
  sizeBytes          Int
  alternativeText    String
  displayOrder       Int
  createdByAccountId String                   @db.Uuid
  createdAt          DateTime                 @default(now()) @db.Timestamptz(6)
  detachedAt         DateTime?                @db.Timestamptz(6)

  @@unique([resourceType, resourceId, displayOrder], map: "CatalogMediaAsset_attached_order_key", where: raw("\"detachedAt\" IS NULL"))
  @@index([resourceType, resourceId, detachedAt])
}

// SPEC-05 owns these records; bookingId is an opaque upstream reference.
// No Booking schema or private-media cleanup ownership is introduced here.
model InvitationMediaPolicy {
  bookingId String   @id @db.Uuid
  revision  Int
  cutoffAt  DateTime @db.Timestamptz(6)
}

model InvitationMediaAsset {
  id                    String                @id @db.Uuid
  bookingId             String                @db.Uuid
  revision              Int
  currentFileRevisionId String                @db.Uuid
  detachedAt            DateTime?             @db.Timestamptz(6)
  files                 InvitationMediaFile[]
  currentFile           InvitationMediaFile   @relation("CurrentMediaFile", fields: [currentFileRevisionId, id, bookingId], references: [id, assetId, bookingId], onDelete: NoAction, onUpdate: NoAction, map: "InvitationMediaAsset_current_file_fkey")

  @@unique([id, bookingId])
  @@unique([currentFileRevisionId, id, bookingId])
  @@index([bookingId, detachedAt, id])
}

model InvitationMediaFile {
  id              String                       @id @db.Uuid
  bookingId       String                       @db.Uuid
  assetId         String                       @db.Uuid
  revision        Int
  objectKey       String                       @db.VarChar(256)
  checksumSha256  String                       @db.Char(64)
  contentType     String                       @db.VarChar(16)
  sizeBytes       Int
  width           Int
  height          Int
  altText         String                       @db.VarChar(250)
  acceptedAt      DateTime                     @db.Timestamptz(6)
  policyRevision  Int
  cutoffAt        DateTime                     @db.Timestamptz(6)
  uploadAttemptId String                       @db.Uuid
  asset           InvitationMediaAsset         @relation(fields: [assetId, bookingId], references: [id, bookingId], onDelete: Restrict)
  attempt         InvitationMediaUploadAttempt @relation(fields: [uploadAttemptId, bookingId], references: [id, bookingId], onDelete: Restrict)
  currentFor      InvitationMediaAsset?        @relation("CurrentMediaFile")

  @@unique([assetId, revision])
  @@unique([id, assetId, bookingId])
  @@index([bookingId, acceptedAt, id])
  @@index([objectKey])
}

