model LayoutTemplate {
  id                        String                  @id @default(uuid()) @db.Uuid
  hallId                    String                  @db.Uuid
  lifecycle                 CatalogLifecycle        @default(ACTIVE)
  displayOrder              Int
  revision                  Int                     @default(1)
  currentPublishedVersionId String?                 @db.Uuid
  draftVersionId            String?                 @db.Uuid
  retiredAt                 DateTime?               @db.Timestamptz(6)
  createdByAccountId        String                  @db.Uuid
  updatedByAccountId        String                  @db.Uuid
  createdAt                 DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                @updatedAt @db.Timestamptz(6)
  hall                      Hall                    @relation(fields: [hallId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions                  LayoutTemplateVersion[] @relation("LayoutTemplateVersions")
  tableIdentities           LayoutTableIdentity[]
  currentPublishedVersion   LayoutTemplateVersion?  @relation("LayoutTemplateCurrentVersion", fields: [currentPublishedVersionId, id], references: [id, layoutTemplateId], onDelete: Restrict, onUpdate: NoAction)
  draftVersion              LayoutTemplateVersion?  @relation("LayoutTemplateDraftVersion", fields: [draftVersionId, id], references: [id, layoutTemplateId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([currentPublishedVersionId, id])
  @@unique([draftVersionId, id])
  @@index([hallId, lifecycle, displayOrder, id])
}

model LayoutTemplateVersion {
  id                 String                @id @default(uuid()) @db.Uuid
  layoutTemplateId   String                @db.Uuid
  versionNumber      Int?
  revision           Int                   @default(1)
  state              CatalogVersionState   @default(DRAFT)
  name               String
  description        String
  minGuests          Int
  maxGuests          Int
  createdByAccountId String                @db.Uuid
  publishedAt        DateTime?             @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(6)
  layoutTemplate     LayoutTemplate        @relation("LayoutTemplateVersions", fields: [layoutTemplateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentFor         LayoutTemplate?       @relation("LayoutTemplateCurrentVersion")
  draftFor           LayoutTemplate?       @relation("LayoutTemplateDraftVersion")
  geometry           LayoutTableGeometry[]

  @@unique([id, layoutTemplateId])
  @@unique([layoutTemplateId, versionNumber])
  @@unique([layoutTemplateId], map: "LayoutTemplateVersion_one_draft_key", where: raw("\"state\" = 'DRAFT'"))
  @@unique([layoutTemplateId], map: "LayoutTemplateVersion_one_current_key", where: raw("\"state\" = 'PUBLISHED'"))
  @@index([layoutTemplateId, state])
}

model LayoutTableIdentity {
  id                 String                @id @db.Uuid
  layoutTemplateId   String                @db.Uuid
  createdByAccountId String                @db.Uuid
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  retiredAt          DateTime?             @db.Timestamptz(6)
  layoutTemplate     LayoutTemplate        @relation(fields: [layoutTemplateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  geometry           LayoutTableGeometry[]

  @@unique([id, layoutTemplateId])
  @@index([layoutTemplateId, retiredAt])
}

model LayoutTableGeometry {
  id                      String                @id @default(uuid()) @db.Uuid
  layoutTemplateVersionId String                @db.Uuid
  layoutTemplateId        String                @db.Uuid
  tableId                 String                @db.Uuid
  label                   String
  shape                   LayoutTableShape
  seatCapacity            Int
  x                       Int
  y                       Int
  width                   Int
  height                  Int
  rotationDegrees         Int
  displayOrder            Int
  layoutTemplateVersion   LayoutTemplateVersion @relation(fields: [layoutTemplateVersionId, layoutTemplateId], references: [id, layoutTemplateId], onDelete: Restrict, onUpdate: Cascade)
  tableIdentity           LayoutTableIdentity   @relation(fields: [tableId, layoutTemplateId], references: [id, layoutTemplateId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([layoutTemplateVersionId, tableId])
  @@unique([layoutTemplateVersionId, displayOrder])
  @@index([layoutTemplateId, tableId])
}

model CatalogMediaAsset {
  id                 String                   @id @default(uuid()) @db.Uuid
  resourceType       CatalogMediaResourceType
  resourceId         String                   @db.Uuid
  objectKey          String                   @unique
  checksumSha256     String
  contentType        String
  sizeBytes          Int
  alternativeText    String
  displayOrder       Int
  createdByAccountId String                   @db.Uuid
  createdAt          DateTime                 @default(now()) @db.Timestamptz(6)
  detachedAt         DateTime?                @db.Timestamptz(6)

  @@unique([resourceType, resourceId, displayOrder], map: "CatalogMediaAsset_attached_order_key", where: raw("\"detachedAt\" IS NULL"))
  @@index([resourceType, resourceId, detachedAt])
}

// SPEC-05 owns these records; bookingId is an opaque upstream reference.
// No Booking schema or private-media cleanup ownership is introduced here.
model InvitationMediaPolicy {
  bookingId String   @id @db.Uuid
  revision  Int
  cutoffAt  DateTime @db.Timestamptz(6)
}

model InvitationMediaAsset {
  id                    String                @id @db.Uuid
  bookingId             String                @db.Uuid
  revision              Int
  currentFileRevisionId String                @db.Uuid
  detachedAt            DateTime?             @db.Timestamptz(6)
  files                 InvitationMediaFile[]
  currentFile           InvitationMediaFile   @relation("CurrentMediaFile", fields: [currentFileRevisionId, id, bookingId], references: [id, assetId, bookingId], onDelete: NoAction, onUpdate: NoAction, map: "InvitationMediaAsset_current_file_fkey")

  @@unique([id, bookingId])
  @@unique([currentFileRevisionId, id, bookingId])
  @@index([bookingId, detachedAt, id])
}

model InvitationMediaFile {
  id              String                       @id @db.Uuid
  bookingId       String                       @db.Uuid
  assetId         String                       @db.Uuid
  revision        Int
  objectKey       String                       @db.VarChar(256)
  checksumSha256  String                       @db.Char(64)
  contentType     String                       @db.VarChar(16)
  sizeBytes       Int
  width           Int
  height          Int
  altText         String                       @db.VarChar(250)
  acceptedAt      DateTime                     @db.Timestamptz(6)
  policyRevision  Int
  cutoffAt        DateTime                     @db.Timestamptz(6)
  uploadAttemptId String                       @db.Uuid
  asset           InvitationMediaAsset         @relation(fields: [assetId, bookingId], references: [id, bookingId], onDelete: Restrict)
  attempt         InvitationMediaUploadAttempt @relation(fields: [uploadAttemptId, bookingId], references: [id, bookingId], onDelete: Restrict)
  currentFor      InvitationMediaAsset?        @relation("CurrentMediaFile")

  @@unique([assetId, revision])
  @@unique([id, assetId, bookingId])
  @@index([bookingId, acceptedAt, id])
  @@index([objectKey])
}

