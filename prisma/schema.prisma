enum BillingLedgerKind {
  CHARGE
  PAYMENT
  REFUND
  CREDIT_ADJUSTMENT
}

enum BillingSourceType {
  BASE_BOOKING
  CONTRACT
  PRINT_ORDER
  PAYMENT_ATTEMPT
  PRINT_CREDIT
  MANUAL_REFUND
  CONTRACT_APPENDIX
  INCIDENTAL_FINALIZATION
  INVOICE_ADJUSTMENT
}

enum BillingPaymentPurpose {
  DEPOSIT
  BALANCE
}

enum BillingPaymentProvider {
  VNPAY
  MANUAL
}

enum BillingAttemptState {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  UNKNOWN
}

