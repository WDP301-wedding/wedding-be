  provider             BillingPaymentProvider
  amountVnd            Decimal                      @db.Decimal(18, 0)
  timelineRevisionId   String?                      @db.Uuid
  contractRevisionId   String?                      @db.Uuid
  documentDigest       String?
  state                BillingAttemptState          @default(CREATED)
  terminalEvidenceId   String?                      @db.Uuid
  expiresAt            DateTime                     @db.Timestamptz(6)
  createdAt            DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                     @updatedAt @db.Timestamptz(6)
  booking              Booking                      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  paymentEntries       BillingLedgerEntry[]
  vnpayCheckout        BillingVnpayCheckout?
  providerEvidence     BillingProviderEvidence[]
  providerTransactions BillingProviderTransaction[]

  @@unique([id, bookingId])
  @@unique([bookingId, purpose], map: "BillingPaymentAttempt_one_unresolved_key", where: raw("\"state\" IN ('CREATED', 'PENDING', 'UNKNOWN')"))
  @@index([state, expiresAt])
}

model BillingLedgerEntry {
  id                    String                     @id @db.Uuid
  bookingId             String                     @db.Uuid
  revision              Int
  kind                  BillingLedgerKind
  sourceType            BillingSourceType
  sourceRevisionId      String                     @db.Uuid
  amountVnd             Decimal                    @db.Decimal(18, 0)
  occurredAt            DateTime                   @db.Timestamptz(6)
  sourceEntryId         String?                    @db.Uuid
  paymentAttemptId      String?                    @unique @db.Uuid
  decisionId            String?                    @db.Uuid
  approvedRefundableVnd Decimal?                   @db.Decimal(18, 0)
  reason                String?
  evidenceReference     String?
  createdAt             DateTime                   @default(now()) @db.Timestamptz(6)
  booking               Booking                    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  sourceEntry           BillingLedgerEntry?        @relation("BillingAdjustments", fields: [sourceEntryId, bookingId], references: [id, bookingId], onDelete: Restrict, onUpdate: NoAction)
  adjustments           BillingLedgerEntry[]       @relation("BillingAdjustments")
  paymentAttempt        BillingPaymentAttempt?     @relation(fields: [paymentAttemptId, bookingId], references: [id, bookingId], onDelete: Restrict, onUpdate: NoAction)
  events                BillingOutboxEvent[]
  invoices              BillingInvoice[]
  depositApplication    BillingDepositApplication?

  @@unique([id, bookingId])
  @@unique([sourceType, sourceRevisionId])
  @@unique([bookingId], map: "BillingLedgerEntry_one_contract_obligation_key", where: raw("\"sourceType\" = 'CONTRACT'"))
  @@unique([bookingId, revision])
  @@index([bookingId, occurredAt])
  @@index([sourceEntryId])
  @@index([decisionId])
}

