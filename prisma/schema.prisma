generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum AuditActorType {
  SYSTEM
  USER
  GUEST_LINK
}

enum IdempotencyStatus {
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AccountRoleType {
  MANAGER
  STAFF
  COUPLE
}

enum ConsultationAccessLevel {
  RESTRICTED
  FULL
}

enum WorkspaceInvitationStatus {
  ACTIVE
  ACCEPTED
  REVOKED
  SUPERSEDED
  EXPIRED
}

enum SessionClientKind {
  WEB
  ANDROID
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  COMPROMISED
}

enum CredentialStatus {
  ACTIVE
  CONSUMED
  REVOKED
  EXPIRED
}

enum CatalogLifecycle {
  ACTIVE
  RETIRED
}

enum CatalogVersionState {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum RestaurantShiftCode {
  LUNCH
  DINNER
}

enum LayoutTableShape {
  ROUND
  RECTANGLE
}

enum CatalogMediaResourceType {
  RESTAURANT_PROFILE
  HALL
  DISH_VERSION
  MENU_PACKAGE_VERSION
  TIMELINE_TEMPLATE_VERSION
  LAYOUT_TEMPLATE_VERSION
}

enum BookingPhase {
  DRAFT
  AWAITING_DEPOSIT
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BookingInvitationIntentStatus {
  PENDING
  ISSUED
}

enum BookingSlotHoldStatus {
  ACTIVE
  EXPIRED
  RELEASED
  CONSUMED
}

enum DepositIntentPinStatus {
  NONE
  ACTIVE
  UNKNOWN
  SETTLED
  FAILED
}

enum BookingTimelineRevisionState {
  CURRENT
  SUPERSEDED
  EFFECTIVE
}

enum BookingTimelineParty {
  MANAGER
  COUPLE
}

enum BookingTimelineDecisionType {
  APPROVED
  WITHDRAWN
}

enum BookingDepositIntentStatus {
  ACTIVE
  UNKNOWN
  RELEASED
  SETTLED
}

enum BookingPromotionStatus {
  PENDING
  SUCCEEDED
}

enum BookingCancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  occurredAt DateTime       @default(now()) @db.Timestamptz(6)
  requestId  String         @db.Uuid
  actorType  AuditActorType
  actorId    String?        @db.Uuid
  action     String
  entityType String
  entityId   String?        @db.Uuid
  metadata   Json           @db.JsonB

  @@index([occurredAt(sort: Desc)])
  @@index([requestId])
  @@index([actorType, actorId])
  @@index([entityType, entityId])
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  namespace      String
  idempotencyKey String
  requestHash    String
  status         IdempotencyStatus
  responseStatus Int?              @db.SmallInt
  responseBody   Json?             @db.JsonB
  resourceType   String?
  resourceId     String?           @db.Uuid
  lockedAt       DateTime          @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime          @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  @@unique([namespace, idempotencyKey])
  @@index([status, lockedAt])
  @@index([expiresAt])
  @@index([resourceType, resourceId])
}

model Account {
  id                     String                            @id @default(uuid()) @db.Uuid
  emailNormalized        String                            @unique
  displayEmail           String
  displayName            String?
  profileRevision        Int                               @default(1)
  status                 AccountStatus                     @default(ACTIVE)
  disabledAt             DateTime?                         @db.Timestamptz(6)
  piiRetentionEligibleAt DateTime?                         @db.Timestamptz(6)
  piiAnonymizedAt        DateTime?                         @db.Timestamptz(6)
  legalHoldUntil         DateTime?                         @db.Timestamptz(6)
  createdAt              DateTime                          @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                          @updatedAt @db.Timestamptz(6)
  passwordCredential     PasswordCredential?
  roles                  AccountRole[]
  consultationAccesses   ConsultationAccess[]
  invitations            WorkspaceInvitation[]             @relation("InvitationAccount")
  issuedInvitations      WorkspaceInvitation[]             @relation("InvitationIssuer")
  sessions               Session[]
  passwordResets         PasswordResetCredential[]
  passwordOtpChallenges  PasswordOtpChallenge[]
  retentionFacts         AccountRetentionEligibilityFact[]

  @@index([status])
  @@index([piiRetentionEligibleAt])
}

model PasswordCredential {
  accountId         String   @id @db.Uuid
  algorithm         String
  version           Int      @db.SmallInt
  cost              Int
  blockSize         Int
  parallelization   Int
  keyLengthBytes    Int      @db.SmallInt
  maxMemoryBytes    Int
  saltEncoded       String
  derivedKeyEncoded String
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model AccountRole {
  id        String          @id @default(uuid()) @db.Uuid
  accountId String          @db.Uuid
  role      AccountRoleType
  grantedAt DateTime        @default(now()) @db.Timestamptz(6)
  account   Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, role])
  @@index([role])
}

model ConsultationAccess {
  id              String                  @id @default(uuid()) @db.Uuid
  accountId       String                  @db.Uuid
  consultationId  String                  @db.Uuid
  bookingId       String?                 @unique @db.Uuid
  level           ConsultationAccessLevel @default(RESTRICTED)
  promotedAt      DateTime?               @db.Timestamptz(6)
  sourcePaymentId String?                 @unique @db.Uuid
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(6)
  account         Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, consultationId])
  @@index([consultationId, level])
}

model WorkspaceInvitation {
  id                       String                    @id @default(uuid()) @db.Uuid
  consultationId           String                    @db.Uuid
  recipientEmailNormalized String
  resolvedAccountId        String?                   @db.Uuid
  issuedByAccountId        String                    @db.Uuid
  sequence                 Int
  tokenHash                String                    @unique
  deliveryIntentId         String                    @default(uuid()) @db.Uuid
  status                   WorkspaceInvitationStatus @default(ACTIVE)
  expiresAt                DateTime                  @db.Timestamptz(6)
  acceptedAt               DateTime?                 @db.Timestamptz(6)
  revokedAt                DateTime?                 @db.Timestamptz(6)
  supersededAt             DateTime?                 @db.Timestamptz(6)
  expiredAt                DateTime?                 @db.Timestamptz(6)
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(6)
  resolvedAccount          Account?                  @relation("InvitationAccount", fields: [resolvedAccountId], references: [id], onDelete: SetNull)
  issuedByAccount          Account                   @relation("InvitationIssuer", fields: [issuedByAccountId], references: [id], onDelete: Restrict)

  @@unique([consultationId, recipientEmailNormalized, sequence])
  @@unique([consultationId, recipientEmailNormalized], map: "WorkspaceInvitation_active_consultation_email_key", where: raw("\"status\" = 'ACTIVE'"))
  @@index([recipientEmailNormalized, createdAt(sort: Desc)])
  @@index([status, expiresAt])
}

model Session {
  id                 String              @id @default(uuid()) @db.Uuid
  accountId          String              @db.Uuid
  clientKind         SessionClientKind
  status             SessionStatus       @default(ACTIVE)
  refreshFamilyId    String              @unique @db.Uuid
  idleExpiresAt      DateTime            @db.Timestamptz(6)
  absoluteExpiresAt  DateTime            @db.Timestamptz(6)
  lastSeenAt         DateTime            @default(now()) @db.Timestamptz(6)
  revokedAt          DateTime?           @db.Timestamptz(6)
  revocationReason   String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  account            Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessCredentials  AccessCredential[]
  refreshCredentials RefreshCredential[]

  @@index([accountId, status])
  @@index([status, idleExpiresAt])
  @@index([status, absoluteExpiresAt])
}

model AccessCredential {
  id        String           @id @default(uuid()) @db.Uuid
  sessionId String           @db.Uuid
  tokenHash String           @unique
  status    CredentialStatus @default(ACTIVE)
  expiresAt DateTime         @db.Timestamptz(6)
  revokedAt DateTime?        @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  session   Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([status, expiresAt])
}

model RefreshCredential {
  id            String             @id @default(uuid()) @db.Uuid
  sessionId     String             @db.Uuid
  predecessorId String?            @unique @db.Uuid
  tokenHash     String             @unique
  status        CredentialStatus   @default(ACTIVE)
  expiresAt     DateTime           @db.Timestamptz(6)
  consumedAt    DateTime?          @db.Timestamptz(6)
  revokedAt     DateTime?          @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  session       Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  predecessor   RefreshCredential? @relation("RefreshRotation", fields: [predecessorId], references: [id], onDelete: Restrict)
  successor     RefreshCredential? @relation("RefreshRotation")

  @@index([sessionId, status])
  @@index([status, expiresAt])
}

model PasswordOtpChallenge {
  id                    String           @id @default(uuid()) @db.Uuid
  accountId             String           @db.Uuid
  purpose               String
  sessionId             String?          @db.Uuid
  codeHash              String
  credentialFingerprint String
  attempts              Int              @default(0)
  status                CredentialStatus @default(ACTIVE)
  expiresAt             DateTime         @db.Timestamptz(6)
  createdAt             DateTime         @default(now()) @db.Timestamptz(6)
  consumedAt            DateTime?        @db.Timestamptz(6)
  account               Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, createdAt(sort: Desc)])
  @@index([expiresAt])
}

model PasswordResetCredential {
  id         String           @id @default(uuid()) @db.Uuid
  accountId  String           @db.Uuid
  tokenHash  String           @unique
  status     CredentialStatus @default(ACTIVE)
  expiresAt  DateTime         @db.Timestamptz(6)
  consumedAt DateTime?        @db.Timestamptz(6)
  revokedAt  DateTime?        @db.Timestamptz(6)
  expiredAt  DateTime?        @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  account    Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
  @@index([status, expiresAt])
}

model AccountRetentionEligibilityFact {
  id                     String   @id @default(uuid()) @db.Uuid
  accountId              String   @db.Uuid
  consultationId         String   @db.Uuid
  sourceBusinessRecordId String   @db.Uuid
  eligibleAfter          DateTime @db.Timestamptz(6)
  recordedAt             DateTime @default(now()) @db.Timestamptz(6)
  account                Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, consultationId])
  @@unique([accountId, sourceBusinessRecordId])
  @@index([accountId, eligibleAfter])
}

model Consultation {
  intakeRequest           ConsultationRequest?
  id                      String                   @id @db.Uuid
  managerAccountId        String                   @db.Uuid
  intendedEmailNormalized String
  intendedEmail           String
  displayName             String
  brideName               String?
  groomName               String?
  note                    String?
  revision                Int                      @default(1)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(6)
  booking                 Booking?
  invitationIntent        BookingInvitationIntent?

  @@index([managerAccountId, createdAt(sort: Desc)])
  @@index([intendedEmailNormalized])
}

model ConsultationRequest {
  id             String        @id @default(uuid()) @db.Uuid
  submissionId   String        @unique @db.Uuid
  payloadHash    String
  displayName    String
  brideName      String?
  groomName      String?
  email          String
  phone          String
  preferredDate  DateTime?     @db.Date
  expectedGuests Int?
  message        String
  status         String        @default("NEW")
  consultationId String?       @unique @db.Uuid
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt, id], map: "ConsultationRequest_status_created")
}

model Booking {
  id                          String                       @id @db.Uuid
  consultationId              String                       @unique @db.Uuid
  hallId                      String                       @db.Uuid
  eventDate                   DateTime                     @db.Date
  shiftCode                   RestaurantShiftCode
  phase                       BookingPhase                 @default(DRAFT)
  revision                    Int                          @default(1)
  planningHeadcount           Int
  cancelledAt                 DateTime?                    @db.Timestamptz(6)
  completedAt                 DateTime?                    @db.Timestamptz(6)
  currentTimelineRevisionId   String?                      @unique @db.Uuid
  effectiveTimelineRevisionId String?                      @unique @db.Uuid
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                     @updatedAt @db.Timestamptz(6)
  consultation                Consultation                 @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  proposalSnapshot            BookingProposalSnapshot?
  slotHolds                   BookingSlotHold[]
  timelineRevisions           BookingTimelineRevision[]    @relation("BookingTimelineRevisions")
  currentTimelineRevision     BookingTimelineRevision?     @relation("BookingCurrentTimeline", fields: [currentTimelineRevisionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  effectiveTimelineRevision   BookingTimelineRevision?     @relation("BookingEffectiveTimeline", fields: [effectiveTimelineRevisionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  depositIntents              BookingDepositIntent[]
  depositSettlement           BookingDepositSettlement?
  cancellationRequests        BookingCancellationRequest[]
  headcountEvidence           BookingHeadcountEvidence?
  billingLedgerHead           BillingLedgerHead?
  billingLedgerEntries        BillingLedgerEntry[]
  billingPaymentAttempts      BillingPaymentAttempt[]
  billingInvoices             BillingInvoice[]
  billingCommands             BillingOperationCommand[]
  billingRefundApprovals      BillingRefundApproval[]
  commercialContract          CommercialContract?
  commercialAppendices        CommercialAppendixHead?

  @@unique([hallId, eventDate, shiftCode], map: "Booking_one_confirmed_slot_key", where: raw("\"phase\" IN ('CONFIRMED', 'COMPLETED')"))
  @@index([hallId, eventDate, shiftCode])
  @@index([phase, eventDate])
}

enum CommercialContractState {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  SUPERSEDED
}

enum CommercialLineCategory {
  MENU
  PRINT
  SERVICE
}

model CommercialContract {
  bookingId         String                       @id @db.Uuid
  modelVersion      String                       @default("FULL_CONTRACT_V1")
  currentRevisionId String?                      @unique @db.Uuid
  booking           Booking                      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  currentRevision   CommercialContractRevision?  @relation("CurrentCommercialRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  revisions         CommercialContractRevision[] @relation("CommercialHistory")
}

model CommercialContractRevision {
  id                    String                       @id @db.Uuid
  bookingId             String                       @db.Uuid
  revisionNumber        Int
  predecessorRevisionId String?                      @db.Uuid
  timelineRevisionId    String                       @db.Uuid
  state                 CommercialContractState      @default(DRAFT)
  document              Json                         @db.JsonB
  documentDigest        String
  contractTotalVnd      Decimal                      @db.Decimal(18, 0)
  depositAmountVnd      Decimal                      @db.Decimal(18, 0)
  createdByAccountId    String                       @db.Uuid
  createdAt             DateTime                     @db.Timestamptz(6)
  submittedAt           DateTime?                    @db.Timestamptz(6)
  approvedAt            DateTime?                    @db.Timestamptz(6)
  contract              CommercialContract           @relation("CommercialHistory", fields: [bookingId], references: [bookingId], onDelete: Restrict)
  currentFor            CommercialContract?          @relation("CurrentCommercialRevision")
  lines                 CommercialContractLine[]
  approvals             CommercialContractApproval[]
  pdf                   CommercialContractPdf?

  @@unique([bookingId, revisionNumber])
  @@unique([id, bookingId])
}

model CommercialContractLine {
  id               String                     @id @db.Uuid
  revisionId       String                     @db.Uuid
  displayOrder     Int
  category         CommercialLineCategory
  sourceId         String                     @db.Uuid
  sourceRevisionId String                     @db.Uuid
  name             String
  description      String
  unit             String
  quantity         Int
  unitPriceVnd     Decimal                    @db.Decimal(18, 0)
  lineTotalVnd     Decimal                    @db.Decimal(18, 0)
  revision         CommercialContractRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@unique([revisionId, displayOrder])
  @@unique([revisionId, category, sourceId])
}

model CommercialContractApproval {
  id             String                     @id @db.Uuid
  revisionId     String                     @db.Uuid
  party          BookingTimelineParty
  actorAccountId String                     @db.Uuid
  documentDigest String
  requestId      String                     @db.Uuid
  occurredAt     DateTime                   @db.Timestamptz(6)
  revision       CommercialContractRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@unique([revisionId, party])
}

model CommercialContractPdf {
  revisionId String                     @id @db.Uuid
  bytes      Bytes                      @db.ByteA
  sha256     String
  createdAt  DateTime                   @db.Timestamptz(6)
  revision   CommercialContractRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
}

model CommercialAppendixHead {
  bookingId           String                       @id @db.Uuid
  currentRevisionId   String?                      @unique @db.Uuid
  effectiveRevisionId String?                      @unique @db.Uuid
  booking             Booking                      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  currentRevision     CommercialAppendixRevision?  @relation("CurrentAppendix", fields: [currentRevisionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  effectiveRevision   CommercialAppendixRevision?  @relation("EffectiveAppendix", fields: [effectiveRevisionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  revisions           CommercialAppendixRevision[] @relation("AppendixHistory")
}

model CommercialAppendixRevision {
  id                    String                       @id @db.Uuid
  bookingId             String                       @db.Uuid
  revisionNumber        Int
  predecessorRevisionId String                       @db.Uuid
  contractRevisionId    String                       @db.Uuid
  state                 CommercialContractState      @default(DRAFT)
  document              Json                         @db.JsonB
  documentDigest        String
  deltaVnd              Decimal                      @db.Decimal(18, 0)
  effectiveTotalVnd     Decimal                      @db.Decimal(18, 0)
  createdByAccountId    String                       @db.Uuid
  createdAt             DateTime                     @db.Timestamptz(6)
  submittedAt           DateTime?                    @db.Timestamptz(6)
  approvedAt            DateTime?                    @db.Timestamptz(6)
  head                  CommercialAppendixHead       @relation("AppendixHistory", fields: [bookingId], references: [bookingId], onDelete: Restrict)
  currentFor            CommercialAppendixHead?      @relation("CurrentAppendix")
  effectiveFor          CommercialAppendixHead?      @relation("EffectiveAppendix")
  approvals             CommercialAppendixApproval[]

  @@unique([bookingId, revisionNumber])
  @@unique([id, bookingId])
}

model CommercialAppendixApproval {
  id             String                     @id @db.Uuid
  revisionId     String                     @db.Uuid
  party          BookingTimelineParty
  actorAccountId String                     @db.Uuid
  documentDigest String
  requestId      String                     @db.Uuid
  occurredAt     DateTime                   @db.Timestamptz(6)
  revision       CommercialAppendixRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@unique([revisionId, party])
  @@unique([revisionId, actorAccountId])
}

model BookingCancellationRequest {
  id                   String                           @id @db.Uuid
  bookingId            String                           @db.Uuid
  status               BookingCancellationRequestStatus @default(PENDING)
  reason               String
  requestedByAccountId String                           @db.Uuid
  requestedAt          DateTime                         @db.Timestamptz(6)
  decidedByAccountId   String?                          @db.Uuid
  decisionReason       String?
  decidedAt            DateTime?                        @db.Timestamptz(6)
  booking              Booking                          @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([bookingId], map: "BookingCancellationRequest_one_pending_key", where: raw("\"status\" = 'PENDING'"))
  @@index([status, requestedAt])
}

model BookingHeadcountEvidence {
  bookingId                 String   @id @db.Uuid
  sourceGuestPlanRevisionId String   @map("sourceRsvpRevisionId") @db.Uuid
  sourceSequence            Int
  expectedAttendees         Int
  appliedAt                 DateTime @db.Timestamptz(6)
  booking                   Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([sourceGuestPlanRevisionId], map: "BookingHeadcountEvidence_sourceRsvpRevisionId_key")
  @@index([sourceSequence])
}

model BookingTimelineRevision {
  id                    String                       @id @db.Uuid
  bookingId             String                       @db.Uuid
  revisionNumber        Int
  predecessorRevisionId String?                      @db.Uuid
  state                 BookingTimelineRevisionState @default(CURRENT)
  managerApprovedAt     DateTime?                    @db.Timestamptz(6)
  coupleApprovedAt      DateTime?                    @db.Timestamptz(6)
  contentHash           String
  createdByAccountId    String                       @db.Uuid
  createdAt             DateTime                     @db.Timestamptz(6)
  booking               Booking                      @relation("BookingTimelineRevisions", fields: [bookingId], references: [id], onDelete: Restrict)
  currentFor            Booking?                     @relation("BookingCurrentTimeline")
  effectiveFor          Booking?                     @relation("BookingEffectiveTimeline")
  predecessor           BookingTimelineRevision?     @relation("BookingTimelinePredecessor", fields: [predecessorRevisionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  successors            BookingTimelineRevision[]    @relation("BookingTimelinePredecessor")
  items                 BookingTimelineItem[]
  decisions             BookingTimelineDecision[]
  depositIntents        BookingDepositIntent[]

  @@unique([bookingId, revisionNumber])
  @@unique([bookingId], map: "BookingTimelineRevision_one_current_key", where: raw("\"state\" = 'CURRENT'"))
  @@index([bookingId, createdAt(sort: Desc)])
}

model BookingDepositIntent {
  id                      String                     @id @db.Uuid
  bookingId               String                     @db.Uuid
  timelineRevisionId      String                     @db.Uuid
  contractRevisionId      String?                    @db.Uuid
  documentDigest          String?
  amountVnd               Decimal                    @db.Decimal(18, 0)
  status                  BookingDepositIntentStatus @default(ACTIVE)
  bookingRevisionReserved Int
  coupleAccountId         String                     @db.Uuid
  requestId               String                     @db.Uuid
  expiresAt               DateTime                   @db.Timestamptz(6)
  providerEvidenceId      String?
  releasedAt              DateTime?                  @db.Timestamptz(6)
  settledAt               DateTime?                  @db.Timestamptz(6)
  createdAt               DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                   @updatedAt @db.Timestamptz(6)
  booking                 Booking                    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  timelineRevision        BookingTimelineRevision    @relation(fields: [timelineRevisionId], references: [id], onDelete: Restrict)

  @@unique([bookingId], map: "BookingDepositIntent_one_unresolved_key", where: raw("\"status\" IN ('ACTIVE', 'UNKNOWN')"))
  @@index([status, expiresAt])
  @@index([timelineRevisionId])
}

model BookingDepositSettlement {
  paymentId          String                 @id @db.Uuid
  bookingId          String                 @unique @db.Uuid
  timelineRevisionId String                 @db.Uuid
  contractRevisionId String?                @db.Uuid
  documentDigest     String?
  amountVnd          Decimal                @db.Decimal(18, 0)
  settledAt          DateTime               @db.Timestamptz(6)
  promotionStatus    BookingPromotionStatus @default(PENDING)
  promotedAt         DateTime?              @db.Timestamptz(6)
  createdAt          DateTime               @default(now()) @db.Timestamptz(6)
