// W1 prerequisite read-side facts owned by Booking and Payments. No media command
// creates these records or promotes a booking/payment to CONFIRMED.
model Booking {
  id                          String                    @id @default(uuid()) @db.Uuid
  consultationId              String                    @unique @db.Uuid
  hallId                      String                    @db.Uuid
  shiftCode                   String
  eventDate                   DateTime                  @db.Date
  phase                       String                    @default("DRAFT")
  revision                    Int                       @default(1)
  planningHeadcount           Int                       @default(0)
  effectiveTimelineRevisionId String?                   @db.Uuid
  confirmedPaymentId          String?                   @db.Uuid
  confirmedAt                 DateTime?                 @db.Timestamptz(6)
  timelines                   BookingTimelineRevision[] @relation("BookingTimelines")
  deposit                     DepositSettlement?        @relation("BookingDeposit")
  effectiveTimeline           BookingTimelineRevision?  @relation("EffectiveBookingTimeline", fields: [id, effectiveTimelineRevisionId], references: [bookingId, id], onDelete: NoAction, onUpdate: NoAction, map: "Booking_effective_timeline_fkey")
  confirmedPayment            DepositSettlement?        @relation("ConfirmedBookingPayment", fields: [id, confirmedPaymentId], references: [bookingId, paymentId], onDelete: NoAction, onUpdate: NoAction, map: "Booking_confirmed_payment_fkey")

  @@unique([id, effectiveTimelineRevisionId])
  @@unique([id, confirmedPaymentId])
}

model BookingTimelineRevision {
  id                  String    @id @default(uuid()) @db.Uuid
  bookingId           String    @db.Uuid
  revisionNumber      Int
  eventDate           DateTime  @db.Date
  hallName            String
  shiftCode           String
  shiftStartTime      String
  shiftEndTime        String
  items               Json
  approvedByManagerAt DateTime? @db.Timestamptz(6)
  approvedByCoupleAt  DateTime? @db.Timestamptz(6)
  booking             Booking   @relation("BookingTimelines", fields: [bookingId], references: [id], onDelete: Restrict)
  effectiveFor        Booking?  @relation("EffectiveBookingTimeline")

  @@unique([bookingId, revisionNumber])
  @@unique([bookingId, id])
}

model DepositSettlement {
  paymentId         String   @id @db.Uuid
  bookingId         String   @unique @db.Uuid
  amountVnd         Decimal  @db.Decimal(18, 0)
  settledAt         DateTime @db.Timestamptz(6)
  evidenceReference String
  booking           Booking  @relation("BookingDeposit", fields: [bookingId], references: [id], onDelete: Restrict)
  confirmedFor      Booking? @relation("ConfirmedBookingPayment")

  @@unique([bookingId, paymentId])
}

