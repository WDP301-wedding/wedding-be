{
  "name": "wedding-be",
  "version": "0.1.0",
  "private": true,
  "description": "Backend service for the single-restaurant wedding management system.",
  "type": "module",
  "engines": {
    "node": ">=24.11 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node --enable-source-maps --import ./dist/instrumentation.js dist/server.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"tests/**/*.test.ts\"",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:studio": "prisma studio --config prisma.config.ts",
    "api:generate": "tsx scripts/openapi.ts",
    "api:check": "tsx scripts/openapi.ts --check",
    "catalog:seed": "tsx scripts/catalog-seed.ts",
    "retention:identity": "tsx scripts/identity-retention.ts",
    "retention:consultation": "tsx scripts/intake-retention.ts",
    "audit:ci": "tsx scripts/dependency-audit.ts",
    "demo:setup": "node scripts/demo-setup.mjs setup",
    "demo:db:start": "node scripts/demo-setup.mjs start-db",
    "demo:db:stop": "node scripts/demo-setup.mjs stop-db",
    "demo:dev": "node --env-file=.env.demo --import tsx --import ./src/instrumentation.ts src/server.ts"
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-express": "0.70.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/storage-js": "2.116.0",
    "cors": "2.8.6",
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "multer": "2.4.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "resend": "6.31.0",
    "zod": "4.6.5",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
